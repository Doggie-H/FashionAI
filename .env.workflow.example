# Copy to .env.workflow and replace every placeholder before starting infrastructure.
WORKFLOW_POSTGRES_DB=ai_stylist
WORKFLOW_POSTGRES_USER=ai_stylist
WORKFLOW_POSTGRES_PASSWORD=replace-with-a-long-unique-password
WORKFLOW_POSTGRES_PORT=5432
WORKFLOW_REDIS_PASSWORD=replace-with-a-different-long-unique-password
WORKFLOW_REDIS_PORT=6379

# SQLAlchemy synchronous PostgreSQL URL for FastAPI and outbox publisher.
DATABASE_URL=postgresql+psycopg2://ai_stylist:replace-with-a-long-unique-password@127.0.0.1:5432/ai_stylist
CELERY_BROKER_URL=redis://:replace-with-a-different-long-unique-password@127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-different-long-unique-password@127.0.0.1:6379/1
IDEMPOTENCY_REDIS_URL=redis://:replace-with-a-different-long-unique-password@127.0.0.1:6379/2

# Worker and publisher policy.
WORKFLOW_OUTBOX_BATCH_SIZE=50
WORKFLOW_OUTBOX_POLL_SECONDS=2
WORKFLOW_IDEMPOTENCY_LOCK_SECONDS=30
WORKFLOW_IDEMPOTENCY_RESPONSE_TTL_SECONDS=86400
