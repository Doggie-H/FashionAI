# Copy the values into your shell environment; do not commit the referenced secret files.
# Each file must contain only the corresponding credential, without JSON/YAML wrapping.
SLACK_WEBHOOK_URL_FILE=C:\secure\ai-stylist\slack-webhook-url.txt
PAGERDUTY_ROUTING_KEY_FILE=C:\secure\ai-stylist\pagerduty-routing-key.txt
# METRICS_TOKEN_FILE is also required by docker-compose.observability.yml.
METRICS_TOKEN_FILE=C:\secure\ai-stylist\metrics-token.txt
# Use a long non-default local password for Grafana.
GRAFANA_ADMIN_PASSWORD=replace-with-long-unique-password
