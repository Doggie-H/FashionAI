{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StyleVlmTrainingSampleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "dataset_version",
    "split",
    "consent",
    "image",
    "messages",
    "review",
    "source"
  ],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^stylevlm_[a-z0-9]{12,64}$"},
    "dataset_version": {"type": "string", "minLength": 3, "maxLength": 80},
    "split": {"type": "string", "enum": ["train", "eval", "test"]},
    "owner_group_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "wardrobe_group_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_allowed", "captured_at", "retention_policy_id"],
      "properties": {
        "training_allowed": {"const": true},
        "captured_at": {"type": "string", "format": "date-time"},
        "retention_policy_id": {"type": "string", "minLength": 3, "maxLength": 128},
        "withdrawn_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s3_key", "sha256", "mime_type"],
      "properties": {
        "s3_key": {"type": "string", "pattern": "^ai-stylist/"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mime_type": {"type": "string", "enum": ["image/jpeg", "image/png", "image/webp"]}
      }
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 12000}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rubric_version", "reviewer_ids"],
      "properties": {
        "status": {"type": "string", "enum": ["approved"]},
        "rubric_version": {"type": "string", "minLength": 3, "maxLength": 80},
        "reviewer_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3, "maxLength": 128}},
        "disagreement": {"type": "boolean", "default": false}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_status", "provenance"],
      "properties": {
        "license_status": {"type": "string", "enum": ["user_consented", "licensed_internal", "licensed_external"]},
        "provenance": {"type": "string", "minLength": 3, "maxLength": 500}
      }
    }
  }
}
